ixDisplay,\n","    roc_curve,\n","    auc,\n","    roc_auc_score\n",")\n","\n","DEVICE = torch.device(\n","    \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",")\n","\n","print(\"Using device:\", DEVICE)\n","#No GPU access -- My free limit was Consumed in model Trainings"]},{"cell_type":"markdown","source":["Configure Paths"],"metadata":{"id":"mM8Nrb7W-9nV"}},{"cell_type":"code","source":["\n","BASE_PATH = Path(\"/content/drive/MyDrive/fyp\")\n","\n","IMAGE_DIR = BASE_PATH / \"Processed Dataset\" / \"images\"\n","RESULT_ROOT = BASE_PATH / \"results\" / \"federated\"\n","CLEAN_SPLIT_DIR = RESULT_ROOT / \"clean_splits\"\n","MODEL_ROOT = BASE_PATH / \"models\" / \"federated\"\n","\n","CLASS_NAMES = [\n","    \"no_tumor\",\n","    \"meningioma\",\n","    \"glioma\",\n","    \"pituitary\"\n","]\n","\n","IMAGE_SIZE = 224\n","BATCH_SIZE = 8 if DEVICE.type == \"cpu\" else 16\n","\n","# Paths of our three trained models\n","CHECKPOINTS = {\n","    \"Centralized\": BASE_PATH / \"models\" / \"densenet121_best.pth\",\n","\n","    \"IID\": MODEL_ROOT / \"IID\" / \"best_global_weights.pth\",\n","\n","    \"NON_IID_Dirichlet\": MODEL_ROOT / \"NON_IID_Dirichlet\" / \"best_global_weights.pth\"\n","}\n","\n","# Verify everything exists\n","assert IMAGE_DIR.is_dir(), \"Image folder not found\"\n","assert (CLEAN_SPLIT_DIR / \"test.csv\").exists(), \"Clean test CSV missing\"\n","\n","for name, path in CHECKPOINTS.items():\n","    assert path.exists(), f\"Missing {name} model: {path}\"\n","    print(name, \":\", path)\n","\n","RESULT_ROOT.mkdir(parents=True, exist_ok=True)\n","\n","print(\"\\nAll paths verified!\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"4jdEs-i1-K_2","executionInfo":{"status":"ok","timestamp":1792158783351,"user_tz":-300,"elapsed":1885,"user":{"displayName":"Farzam Ameer","userId":"02655195655612286807"}},"outputId":"3283aba1-18c3-4870-ce6f-2fc1e65d5288"},"execution_count":2,"outputs":[{"output_type":"stream","name":"stdout","text":["Centralized : /content/drive/MyDrive/fyp/models/densenet121_best.pth\n","IID : /content/drive/MyDrive/fyp/models/federated/IID/best_global_weights.pth\n","NON_IID_Dirichlet : /content/drive/MyDrive/fyp/models/federated/NON_IID_Dirichlet/best_global_weights.pth\n","\n","All paths verified!\n"]}]},{"cell_type":"markdown","source":["Loading the Cleaned Test Data"],"metadata":{"id":"oOhl0vAb_Tdg"}},{"cell_type":"code","source":["\n","# Load the existing cleaned test set\n","test_df = pd.read_csv(CLEAN_SPLIT_DIR / \"test.csv\")\n","\n","# Check required columns and labels\n","assert {\"image\", \"label\"}.issubset(test_df.columns)\n","assert test_df[[\"image\", \"label\"]].notna().all().all()\n","\n","test_df[\"image\"] = test_df[\"image\"].astype(str).str.strip()\n","test_df[\"label\"] = test_df[\"label\"].astype(int)\n","\n","assert test_df[\"image\"].is_unique\n","assert test_df[\"label\"].isin(range(4)).all()\n","assert test_df[\"label\"].nunique() == 4\n","\n","# Ensure all image files exist\n","missing = [\n","    img for img in test_df[\"image\"]\n","    if not (IMAGE_DIR / img).is_file()\n","]\n","\n","assert not missing, f\"Missing images: {missing[:5]}\"\n","\n","# Confirm no known patient or exact-image overlap\n","for split in [\"train\", \"val\"]:\n","\n","    other = pd.read_csv(CLEAN_SPLIT_DIR / f\"{split}.csv\")\n","\n","    assert set(test_df[\"image\"]).isdisjoint(other[\"image\"])\n","\n","    for column in [\"sha256\", \"group_key\"]:\n","        if column in test_df.columns and column in other.columns:\n","            assert set(test_df[column]).isdisjoint(other[column])\n","\n","print(\"Clean test images:\", len(test_df))\n","\n","print(\"\\nClass distribution:\")\n","print(test_df[\"label\"].value_counts().sort_index())\n","\n","print(\"\\nTest dataset verified!\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"oH-gbArN_V6M","executionInfo":{"status":"ok","timestamp":1792158821901,"user_tz":-300,"elapsed":1346,"user":{"displayName":"Farzam Ameer","userId":"02655195655612286807"}},"outputId":"0d3f5177-6c1e-477e-ce94-667ee4865ab4"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["Clean test images: 422\n","\n","Class distribution:\n","label\n","0    111\n","1    116\n","2     92\n","3    103\n","Name: count, dtype: int64\n","\n","Test dataset verified!\n"]}]},{"cell_type":"markdown","source":["Applying Preprocessing for Test Images"],"metadata":{"id":"bHBl_bQu_fvV"}},{"cell_type":"code","source":["\n","# Image preprocessing\n","test_transform = transforms.Compose([\n","    transforms.Resize((224, 224)),\n","    transforms.ToTensor(),\n","    transforms.Normalize(\n","        mean=[0.485, 0.456, 0.406],\n","        std=[0.229, 0.224, 0.225]\n","    )\n","])\n","\n","# Custom PyTorch dataset\n","class BrainMRIDataset(Dataset):\n","\n","    def __init__(self, dataframe):\n","        self.df = dataframe.reset_index(drop=True)\n","\n","    def __len__(self):\n","        return len(self.df)\n","\n","    def __getitem__(self, index):\n","\n","        row = self.df.iloc[index]\n","\n","        image = Image.open(\n","            IMAGE_DIR / row[\"image\"]\n","        ).convert(\"RGB\")\n","\n","        image = test_transform(image)\n","        label = int(row[\"label\"])\n","\n","        return image, label\n","\n","\n","# Create test DataLoader\n","test_dataset = BrainMRIDataset(test_df)\n","\n","test_loader = DataLoader(\n","    test_dataset,\n","    batch_size=BATCH_SIZE,\n","    shuffle=False,\n","    num_workers=0\n",")\n","\n","print(\"Total test images:\", len(test_dataset))\n","print(\"Total batches:\", len(test_loader))\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"hpJBmvfF_Zt2","executionInfo":{"status":"ok","timestamp":1792158873682,"user_tz":-300,"elapsed":59,"user":{"displayName":"Farzam Ameer","userId":"02655195655612286807"}},"outputId":"22720698-ee44-4780-f816-c5fd97908067"},"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["Total test images: 422\n","Total batches: 53\n"]}]},{"cell_type":"markdown","source":["Load model and Generate Predictions"],"metadata":{"id":"9a5VAUxh_pPL"}},{"cell_type":"code","source":["\n","# Load saved DenseNet121 model\n","def load_model(checkpoint_path):\n","\n","    model = models.densenet121(weights=None)\n","\n","    model.classifier = nn.Linear(\n","        model.classifier.in_features,\n","        4\n","    )\n","\n","    weights = torch.load(\n","        checkpoint_path,\n","        map_location=\"cpu\",\n","        weights_only=True\n","    )\n","\n","    model.load_state_dict(weights)\n","\n","    model = model.to(DEVICE)\n","    model.eval()\n","\n","    return model\n","\n","\n","# Generate predictions on test images\n","@torch.inference_mode()\n","def predict_on_test(model):\n","\n","    actual = []\n","    predicted = []\n","    probabilities = []\n","\n","    for images, labels in test_loader:\n","\n","        images = images.to(DEVICE)\n","\n","        outputs = model(images)\n","\n","        probs = torch.softmax(outputs, dim=1)\n","\n","        actual.extend(labels.numpy())\n","        predicted.extend(probs.argmax(dim=1).cpu().numpy())\n","        probabilities.extend(probs.cpu().numpy())\n","\n","    return (\n","        np.array(actual),\n","        np.array(predicted),\n","        np.array(probabilities)\n","    )\n"],"metadata":{"id":"yuf0pgYi_s7E","executionInfo":{"status":"ok","timestamp":1792158922970,"user_tz":-300,"elapsed":136,"user":{"displayName":"Farzam Ameer","userId":"02655195655612286807"}}},"execution_count":5,"outputs":[]},{"cell_type":"markdown","source":["Evalute Model and Save Metrics"],"metadata":{"id":"oi9rR7DZ_1HU"}},{"cell_type":"code","source":["\n","def evaluate_and_save(name, checkpoint):\n","\n","    print(f\"\\nEvaluating: {name}\")\n","\n","    # Load model and generate predictions\n","    model = load_model(checkpoint)\n","\n","    y_true, y_pred, probs = predict_on_test(model)\n","\n","    del model\n","    gc.collect()\n","\n","    if DEVICE.type == \"cuda\":\n","        torch.cuda.empty_cache()\n","\n","    # Create model results folder\n","    folder = RESULT_ROOT / name\n","    folder.mkdir(parents=True, exist_ok=True)\n","\n","    # 1. Calculate metrics\n","    metrics = {\n","        \"model\": name,\n","        \"test_images\": len(y_true),\n","\n","        \"accuracy\": accuracy_score(y_true, y_pred),\n","\n","        \"precision_macro\": precision_score(\n","            y_true, y_pred, average=\"macro\", zero_division=0\n","        ),\n","\n","        \"recall_macro\": recall_score(\n","            y_true, y_pred, average=\"macro\", zero_division=0\n","        ),\n","\n","        \"f1_macro\": f1_score(\n","            y_true, y_pred, average=\"macro\", zero_division=0\n","        ),\n","\n","        \"f1_weighted\": f1_score(\n","            y_true, y_pred, average=\"weighted\", zero_division=0\n","        )\n","    }\n","\n","    # 2. Classification report\n","    report = classification_report(\n","        y_true, y_pred,\n","        labels=range(4),\n","        target_names=CLASS_NAMES,\n","        zero_division=0\n","    )\n","\n","    print(\"\\nClassification Report:\")\n","    print(report)\n","\n","    (folder / \"test_classification_report.txt\").write_text(report)\n","\n","    report_df = pd.DataFrame(\n","        classification_report(\n","            y_true, y_pred,\n","            labels=range(4),\n","            target_names=CLASS_NAMES,\n","            zero_division=0,\n","            output_dict=True\n","        )\n","    ).T\n","\n","    report_df.to_csv(folder / \"test_classification_report.csv\")\n","\n","    # 3. Confusion matrix\n","    cm = confusion_matrix(y_true, y_pred, labels=range(4))\n","\n","    cm_df = pd.DataFrame(\n","        cm, index=CLASS_NAMES, columns=CLASS_NAMES\n","    )\n","\n","    print(\"\\nConfusion Matrix:\")\n","    print(cm_df)\n","\n","    cm_df.to_csv(folder / \"test_confusion_matrix.csv\")\n","\n","    fig, ax = plt.subplots(figsize=(7, 6))\n","\n","    ConfusionMatrixDisplay(\n","        confusion_matrix=cm,\n","        display_labels=CLASS_NAMES\n","    ).plot(ax=ax, values_format=\"d\", colorbar=False)\n","\n","    ax.set_title(f\"{name} - Confusion Matrix\")\n","    plt.xticks(rotation=25, ha=\"right\")\n","    plt.tight_layout()\n","\n","    plt.savefig(\n","        folder / \"test_confusion_matrix.png\",\n","        dpi=300,\n","        bbox_inches=\"tight\"\n","    )\n","\n","    plt.show()\n","    plt.close(fig)\n","\n","    # 4. ROC curves for each class\n","    y_binary = np.eye(4)[y_true]\n","\n","    fig, ax = plt.subplots(figsize=(7, 6))\n","\n","    for i, class_name in enumerate(CLASS_NAMES):\n","\n","        fpr, tpr, _ = roc_curve(\n","            y_binary[:, i],\n","            probs[:, i]\n","        )\n","\n","        auc_score = auc(fpr, tpr)\n","\n","        metrics[f\"auc_{class_name}\"] = auc_score\n","\n","        ax.plot(\n","            fpr, tpr,\n","            label=f\"{class_name}: AUC={auc_score:.3f}\"\n","        )\n","\n","    metrics[\"roc_auc_macro_ovr\"] = roc_auc_score(\n","        y_true,\n","        probs,\n","        labels=range(4),\n","        multi_class=\"ovr\",\n","        average=\"macro\"\n","    )\n","\n","    ax.plot([0, 1], [0, 1], \"--\")\n","    ax.set_xlabel(\"False Positive Rate\")\n","    ax.set_ylabel(\"True Positive Rate\")\n","    ax.set_title(f\"{name} - ROC Curves\")\n","    ax.legend()\n","\n","    plt.tight_layout()\n","    plt.savefig(\n","        folder / \"test_roc_curves.png\",\n","        dpi=300,\n","        bbox_inches=\"tight\"\n","    )\n","    plt.show()\n","    plt.close(fig)\n","\n","    # 5. Save individual predictions\n","    predictions_df = test_df[[\"image\", \"label\"]].copy()\n","    predictions_df[\"prediction\"] = y_pred\n","\n","    for i, class_name in enumerate(CLASS_NAMES):\n","        predictions_df[f\"prob_{class_name}\"] = probs[:, i]\n","\n","    predictions_df.to_csv(\n","        folder / \"test_predictions.csv\",\n","        index=False\n","    )\n","\n","    # Save metrics\n","    (folder / \"test_metrics.json\").write_text(\n","        json.dumps(metrics, indent=2)\n","    )\n","\n","    print(f\"\\nResults saved to: {folder}\")\n","\n","    return metrics\n"],"metadata":{"id":"zNn7bbBh_3_e","executionInfo":{"status":"ok","timestamp":1792159004433,"user_tz":-300,"elapsed":57,"user":{"displayName":"Farzam Ameer","userId":"02655195655612286807"}}},"execution_count":6,"outputs":[]},{"cell_type":"markdown","source":["Evaluate all three models"],"metadata":{"id":"j_m8W_vnAIBn"}},{"cell_type":"code","source":["\n","all_results = []\n","\n","for name, checkpoint in CHECKPOINTS.items():\n","\n","    result = evaluate_and_save(name, checkpoint)\n","\n","    all_results.append(result)\n","\n","# Create comparison table\n","comparison = pd.DataFrame(all_results)\n","\n","# Save comparison\n","comparison.to_csv(\n","    RESULT_ROOT / \"final_clean_test_comparison.csv\",\n","    index=False\n",")\n","\n","print(\"\\nFINAL MODEL COMPARISON\")\n","\n","display(\n","    comparison[[\n","        \"model\",\n","        \"test_images\",\n","        \"accuracy\",\n","        \"precision_macro\",\n","        \"recall_macro\",\n","        \"f1_macro\",\n","        \"f1_weighted\",\n","        \"roc_auc_macro_ovr\"\n","    ]].round(4)\n",")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"BR5Po0npAKU3","executionInfo":{"status":"ok","timestamp":1792159447515,"user_tz":-300,"elapsed":412465,"user":{"displayName":"Farzam Ameer","userId":"02655195655612286807"}},"outputId":"4a82079b-d4d7-4ac8-8f1e-bc4021b759b2"},"execution_count":7,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Evaluating: Centralized\n","\n","Classification Report:\n","              precision    recall  f1-score   support\n","\n","    no_tumor       1.00      1.00      1.00       111\n","  meningioma       0.97      0.98 