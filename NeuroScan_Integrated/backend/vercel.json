{
  "version": 2,
  "services": {
    "backend": {
      "root": "NeuroScan_Integrated/backend",
      "framework": "express"
    },
    "frontend": {
      "root": "NeuroScan_Integrated/frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "backend"
    },
    {
      "source": "/(.*)",
      "destination": "frontend"
    }
  ]
}